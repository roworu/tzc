{
 "name": "htop",
 "description": "Interactive process viewer",
 "options": [
  {
   "name": [
    "-d",
    "--delay"
   ],
   "description": "Delay between updates, in tenths of a second",
   "args": {
    "name": "delay"
   }
  },
  {
   "name": [
    "-C",
    "--no-color",
    "--no-colour"
   ],
   "description": "Start in monochrome mode"
  },
  {
   "name": [
    "-F",
    "--filter"
   ],
   "description": "Filter processes by terms matching the commands",
   "args": {
    "name": "filter"
   }
  },
  {
   "name": [
    "-h",
    "--help"
   ],
   "description": "Display a help message and exit"
  },
  {
   "name": [
    "-p",
    "--pid"
   ],
   "description": "Show only the given PIDs",
   "args": {
    "name": "pid"
   }
  },
  {
   "name": [
    "-s",
    "--sort-key"
   ],
   "description": "Sort by this column",
   "args": {
    "name": "column",
    "suggestions": [
     "Command",
     "COMM",
     "EXE",
     "PID",
     "STATE",
     "PPID",
     "PGRP",
     "SESSION",
     "TTY",
     "TPGID",
     "PRIORITY",
     "NICE",
     "STARTTIME",
     "PROCESSOR",
     "M_VIRT",
     "M_RESIDENT",
     "M_SHARE",
     "M_TRS",
     "M_DRS",
     "M_LRS",
     "M_SWAP",
     "PERCENT_CPU",
     "PERCENT_NORM_CPU",
     "PERCENT_MEM",
     "USER",
     "TIME",
     "NLWP",
     "TGID"
    ]
   }
  },
  {
   "name": [
    "-u",
    "--user"
   ],
   "description": "Show only the processes of a given user, or self if omitted",
   "args": {
    "name": "user",
    "isOptional": true
   }
  },
  {
   "name": [
    "-U",
    "--no-unicode"
   ],
   "description": "Use ASCII characters instead of unicode for graph meters"
  },
  {
   "name": [
    "-M",
    "--no-mouse"
   ],
   "description": "Disable mouse control"
  },
  {
   "name": "--readonly",
   "description": "Disable all system and process changing features"
  },
  {
   "name": [
    "-V",
    "--version"
   ],
   "description": "Output version information and exit"
  },
  {
   "name": [
    "-t",
    "--tree"
   ],
   "description": "Show processes in tree view"
  },
  {
   "name": [
    "-H",
    "--highlight-changes"
   ],
   "description": "Highlight new and old processes",
   "args": {
    "name": "delay"
   }
  },
  {
   "name": "--drop-capabilities",
   "description": "Drop unneeded Linux capabilities",
   "args": {
    "name": "mode",
    "isOptional": true,
    "suggestions": [
     "off",
     "basic",
     "strict"
    ]
   }
  }
 ]
}
