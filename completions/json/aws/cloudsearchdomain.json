     "args": {}
    },
    {
     "name": "--filter-query",
     "args": {}
    },
    {
     "name": "--highlight",
     "args": {}
    },
    {
     "name": "--no-partial"
    },
    {
     "name": "--partial"
    },
    {
     "name": "--query-options",
     "args": {}
    },
    {
     "name": "--query-parser",
     "args": {
