      ]
     },
     "priority": 75
    },
    {
     "name": "--destination-s3-bucket-name",
     "args": {},
     "priority": 75
    },
    {
     "name": "--destination-s3-prefix",
     "args": {}
    },
    {
     "name": "--from-date",
     "args": {},
     "priority": 75
    },
    {
     "name": "--role-name-arn",
     "args": {},
     "priority": 75
    },
    {
     "name": "--sns-topic-arn",
     "args": {},
     "priority": 75
    }
   ]
  }
 ]
}
