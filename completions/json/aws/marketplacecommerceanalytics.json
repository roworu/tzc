{
 "name": "marketplacecommerceanalytics",
 "description": "Provides AWS Marketplace business intelligence data on-demand.",
 "subcommands": [
  {
   "name": "generate-data-set",
   "description": "Given a data set type and data set publication date, asynchronously publishes the requested data set to the specified S3 bucket and notifies the specified SNS topic once the data is available.",
   "options": [
    {
     "name": "--customer-defined-values",
     "args": {}
    },
    {
     "name": "--data-set-publication-date",
     "args": {},
     "priority": 75
    },
    {
     "name": "--data-set-type",
     "args": {},
     "priority": 75
    },
    {
     "name": "--destination-s3-bucket-name",
     "args": {},
     "priority": 75
    },
    {
     "name": "--destination-s3-prefix",
     "args": {}
    },
    {
     "name": "--role-name-arn",
     "args": {},
     "priority": 75
    },
    {
     "name": "--sns-topic-arn",
     "args": {},
     "priority": 75
    }
   ]
  },
  {
   "name": "start-support-data-export",
