{
  "name": "rm",
  "description": "Remove files or directories",
  "subcommands": [
    {
      "name": "rm",
      "description": "Remove (unlink) the FILE(s)",
      "subcommands": [
        {
          "name": "rm",
          "description": "Remove (unlink) the FILE(s)",
          "subcommands": [
            {
              "name": "rm"
            }
          ],
          "options": [
            {
              "name": [
                "-f",
                "--force"
              ],
              "description": "Ignore nonexistent files and arguments, never prompt"
            },
            {
              "name": "-i",
              "description": "Prompt before every removal"
            },
            {
              "name": "-I",
              "description": "Prompt once before removing more than three files, or when removing recursively"
            },
            {
              "name": "--interactive",
              "description": "Prompt according to WHEN: never, once (-I), or",
              "args": {
                "name": "when",
                "isOptional": true
              }
            },
            {
              "name": "--one-file-system",
              "description": "When removing a hierarchy recursively, skip any directory that is on a file sys…"
            },
            {
              "name": "--no-preserve-root",
              "description": "Do not treat '/' specially"
            },
            {
              "name": "--preserve-root",
              "description": "Do not remove '/'",
              "args": {
                "name": "all",
                "isOptional": true
              }
            },
            {
              "name": [
                "-r",
                "-R",
                "--recursive"
              ],
              "description": "Remove directories and their contents recursively"
            },
            {
              "name": [
                "-d",
                "--dir"
              ],
              "description": "Remove empty directories"
            },
            {
              "name": [
                "-v",
                "--verbose"
              ],
              "description": "Explain what is being done"
            },
            {
              "name": "--help",
              "description": "Display this help and exit"
            },
            {
              "name": "--version",
              "description": "Output version information and exit"
            }
          ],
          "args": [
            {
              "name": "file",
              "template": "filepaths",
              "isOptional": true,
              "isVariadic": true
            }
          ]
        }
      ],
