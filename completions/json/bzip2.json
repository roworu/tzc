{
 "name": "bzip2",
 "description": "Block-sorting file compressor",
 "options": [
  {
   "name": [
    "-h",
    "--help"
   ],
   "description": "Print help message"
  },
  {
   "name": [
    "-d",
    "--decompress"
   ],
   "description": "Force decompression"
  },
  {
   "name": [
    "-z",
    "--compress"
   ],
   "description": "Force compression"
  },
  {
   "name": [
    "-k",
    "--keep"
   ],
   "description": "Keep input files"
  },
  {
   "name": [
    "-f",
    "--force"
   ],
   "description": "Overwrite existing output files"
  },
  {
   "name": [
    "-t",
    "--test"
   ],
   "description": "Test compressed file integrity"
  },
  {
   "name": [
    "-c",
    "--stdout"
   ],
   "description": "Output to standard out"
  },
  {
   "name": [
    "-q",
    "--quiet"
   ],
   "description": "Suppress noncritical error messages"
  },
  {
   "name": [
    "-v",
    "--verbose"
   ],
   "description": "Be verbose",
   "isRepeatable": true
  },
  {
   "name": [
    "-L",
    "--license"
   ],
   "description": "Display software version and license"
  },
  {
   "name": [
    "-V",
    "--version"
   ],
   "description": "Display software version and license"
  },
  {
   "name": [
    "-s",
    "--small"
   ],
   "description": "Use less memory (at most 2500k)"
  },
  {
   "name": "--fast",
   "description": "Alias for -1"
  },
  {
   "name": "--best",
   "description": "Alias for -9"
  }
 ],
 "args": {
  "name": "file",
  "template": "filepaths",
  "isOptional": true,
  "isVariadic": true
 }
}
